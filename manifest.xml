<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xsi:type="TaskPaneApp">
  <Id>7b3d9f52-1c4a-4e8b-9a61-5d2f0c8e4a17</Id>
  <Version>1.0.0.15</Version>
  <ProviderName>TexEq</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="JeFTeX"/>
  <Description DefaultValue="LaTeX to SVG equations, with MathType conversion"/>
  <IconUrl DefaultValue="https://binnej.github.io/jeftex/icon.png?v=7"/>
  <HighResolutionIconUrl DefaultValue="https://binnej.github.io/jeftex/icon.png?v=7"/>
  <SupportUrl DefaultValue="https://binnej.github.io/jeftex"/>
  <AppDomains><AppDomain>https://binnej.github.io/jeftex</AppDomain></AppDomains>
  <Hosts><Host Name="Document"/></Hosts>
  <DefaultSettings><SourceLocation DefaultValue="https://binnej.github.io/jeftex/taskpane.html?v=15"/></DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="TexGroup">
                <Label resid="L"/>
                <Icon><bt:Image size="16" resid="I"/><bt:Image size="32" resid="I"/><bt:Image size="80" resid="I"/></Icon>
                <Control xsi:type="Button" id="TexBtn">
                  <Label resid="L"/>
                  <Supertip><Title resid="L"/><Description resid="D"/></Supertip>
                  <Icon><bt:Image size="16" resid="I"/><bt:Image size="32" resid="I"/><bt:Image size="80" resid="I"/></Icon>
                  <Action xsi:type="ShowTaskpane"><TaskpaneId>TexPane</TaskpaneId><SourceLocation resid="U"/></Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images><bt:Image id="I" DefaultValue="https://binnej.github.io/jeftex/icon.png?v=7"/></bt:Images>
      <bt:Urls><bt:Url id="U" DefaultValue="https://binnej.github.io/jeftex/taskpane.html?v=15"/></bt:Urls>
      <bt:ShortStrings><bt:String id="L" DefaultValue="JeFTeX"/></bt:ShortStrings>
      <bt:LongStrings><bt:String id="D" DefaultValue="Insert and edit LaTeX equations as SVG, convert MathType equations"/></bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>